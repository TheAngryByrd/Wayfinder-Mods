{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wayfinder mod manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "archiveName",
    "includeWayfinderSignature"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "archiveName": {
      "type": "string",
      "pattern": "^[^\\\\/]+\\.zip$"
    },
    "includeWayfinderSignature": {
      "type": "boolean"
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        }
      }
    }
  }
}
